---
import type { NormalizedEntry } from "../lib/content-model";
import { formatDate } from "../lib/utils";

interface Props {
  entry: NormalizedEntry;
}

const { entry } = Astro.props;
---

<article class="card">
  <div class="meta-row">
    <span class={`pill ${entry.type}`}>{entry.type === "article" ? "文章" : "笔记"}</span>
    <span>分类 · {entry.category}</span>
    <span>更新 · {formatDate(entry.updated)}</span>
  </div>

  <h3><a href={entry.url}>{entry.title}</a></h3>
  <p>{entry.summary}</p>

  <div class="card-footer">
    <ul class="tags">
      {entry.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <a class="read-more" href={entry.url}>继续阅读</a>
  </div>
</article>

<style>
  .card {
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 1.2rem;
    background: rgba(255, 250, 242, 0.84);
    backdrop-filter: blur(10px);
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .pill.article {
    color: #7d2f16;
    background: rgba(201, 92, 35, 0.14);
  }

  .pill.note {
    color: #0d5764;
    background: rgba(25, 124, 140, 0.14);
  }

  h3 {
    margin: 0.75rem 0 0.55rem;
    font-size: 1.32rem;
  }

  h3 a {
    color: inherit;
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
  }

  p {
    margin: 0 0 0.9rem;
    color: var(--muted-strong);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
    color: var(--muted);
    font-size: 0.84rem;
  }

  .tags li {
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: rgba(37, 62, 54, 0.06);
  }

  .card-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: space-between;
    align-items: flex-end;
  }

  .read-more {
    color: var(--accent);
    text-decoration: none;
    font-weight: 700;
    white-space: nowrap;
  }

  .read-more:hover {
    text-decoration: underline;
  }
</style>
