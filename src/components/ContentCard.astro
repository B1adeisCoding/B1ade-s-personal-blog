---
import type { NormalizedEntry } from "../lib/content-model";
import { formatDate } from "../lib/utils";

interface Props {
  entry: NormalizedEntry;
}

const { entry } = Astro.props;
---

<article class="card">
  <div class="meta-row">
    <span class={`pill ${entry.type}`}>{entry.type === "article" ? "文章" : "笔记"}</span>
    <span>分类 · {entry.category}</span>
    <span>更新 · {formatDate(entry.updated)}</span>
  </div>

  <h3><a href={entry.url}>{entry.title}</a></h3>
  <p>{entry.summary}</p>

  <div class="card-footer">
    <ul class="tags">
      {entry.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <a class="read-more" href={entry.url}>继续阅读</a>
  </div>
</article>

<style>
  .card {
    display: grid;
    gap: 0.95rem;
    padding: 1.4rem;
    border: 1px solid rgba(255, 255, 255, 0.44);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.4);
    backdrop-filter: var(--blur-md);
    -webkit-backdrop-filter: var(--blur-md);
    box-shadow: var(--shadow-soft);
    transition:
      var(--transition);
  }

  .card:hover {
    transform: translateY(-2px);
    border-color: var(--line-strong);
    box-shadow: var(--shadow-panel);
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    padding: 0.18rem 0.58rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .pill.article {
    color: #355262;
    background: rgba(62, 95, 115, 0.14);
  }

  .pill.note {
    color: #274753;
    background: rgba(74, 114, 136, 0.14);
  }

  h3 {
    margin: 0;
    font-size: 1.32rem;
    line-height: 1.15;
  }

  h3 a {
    color: inherit;
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--accent-strong);
  }

  p {
    margin: 0;
    color: var(--muted-strong);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
    color: var(--muted);
    font-size: 0.84rem;
  }

  .tags li {
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.34);
    border: 1px solid rgba(255, 255, 255, 0.38);
  }

  .card-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: space-between;
    align-items: flex-end;
  }

  .read-more {
    color: var(--accent);
    text-decoration: none;
    font-weight: 700;
    white-space: nowrap;
  }

  .read-more:hover {
    color: var(--accent-strong);
  }
</style>
