---
const links = [
  { href: "/", label: "首页" },
  { href: "/categories/", label: "分类" },
  { href: "/tags/", label: "标签" },
  { href: "/about/", label: "关于" },
];

const pathname = Astro.url.pathname;
---

<header class="site-header">
  <a class="brand" href="/">
    <span class="brand-mark">PT</span>
    <span>
      <strong>Paper Trail</strong>
      <small>personal knowledge garden</small>
    </span>
  </a>

  <nav aria-label="Primary">
    <ul>
      {links.map((link) => (
        <li>
          <a href={link.href} data-active={pathname === link.href || pathname.startsWith(link.href + "")}>
            {link.label}
          </a>
        </li>
      ))}
      <li><a class="search-link" href="/search/">搜索</a></li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    padding: 1rem 0 2rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    text-decoration: none;
    color: inherit;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 2.8rem;
    aspect-ratio: 1;
    border-radius: 0.9rem;
    background: var(--accent);
    color: var(--paper);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .brand strong,
  .brand small {
    display: block;
  }

  .brand small {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.68rem;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  nav a {
    color: inherit;
    text-decoration: none;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    border: 1px solid transparent;
  }

  nav a[data-active="true"],
  nav a:hover {
    border-color: var(--border);
    background: rgba(37, 62, 54, 0.06);
  }

  .search-link {
    background: var(--ink);
    color: var(--paper);
  }

  @media (max-width: 800px) {
    .site-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
