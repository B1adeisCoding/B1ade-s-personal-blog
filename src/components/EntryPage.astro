---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

import ContentCard from "./ContentCard.astro";
import Layout from "../layouts/Layout.astro";
import type { NormalizedEntry } from "../lib/content-model";
import { formatDate, slugify } from "../lib/utils";

type HeadingLink = {
  depth: number;
  slug: string;
  text: string;
};

interface Props {
  entry: {
    data: {
      title: string;
      summary: string;
      category: string;
      tags: string[];
      date: Date;
      updated: Date;
      hidden: boolean;
      type: "article" | "note";
    };
  };
  Content: AstroComponentFactory;
  headings: HeadingLink[];
  previousEntry?: NormalizedEntry;
  nextEntry?: NormalizedEntry;
  relatedEntries: NormalizedEntry[];
}

const { entry, Content, headings, previousEntry, nextEntry, relatedEntries } = Astro.props;
const isNote = entry.data.type === "note";
const typeLabel = isNote ? "Note" : "Article";
const asideHeading = headings.length > 0 ? "目录" : "页面信息";
---

<Layout title={entry.data.title} description={entry.data.summary}>
  <article class="entry-shell" id="top">
    <header class:list={["hero-panel", isNote && "note-hero"]}>
      <p class="kicker">{typeLabel}</p>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.summary}</p>
      <ul class="meta-list">
        <li>分类：{entry.data.category}</li>
        <li>创建：{formatDate(entry.data.date)}</li>
        <li>更新：{formatDate(entry.data.updated)}</li>
        <li>隐藏：{entry.data.hidden ? "是" : "否"}</li>
      </ul>
    </header>

    <div class="entry-layout">
      <div class="entry-prose">
        <Content />

        <div class="entry-actions">
          <a href="#top">返回顶部</a>
        </div>
      </div>

      <aside class="entry-aside">
        <section class="aside-section toc-section">
          <h2>{asideHeading}</h2>
          {headings.length > 0 ? (
            <nav class="toc-nav" aria-label="文章目录">
              <ol class="toc-list">
                {headings.map((heading) => (
                  <li class:list={[heading.depth === 3 && "nested"]}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          ) : (
            <p class="aside-empty">当前这篇内容没有可用的小节目录。</p>
          )}
        </section>

        <section class="aside-section">
          <h2>标签</h2>
          <ul class="tag-cloud">
            {entry.data.tags.map((tag) => (
              <li>
                <a href={`/tags/${slugify(tag)}/`}>{tag}</a>
              </li>
            ))}
          </ul>
        </section>
      </aside>
    </div>

    {(previousEntry || nextEntry) && (
      <section class="section-block">
        <div class="navigation-grid">
          {previousEntry ? (
            <a class="nav-card" href={previousEntry.url}>
              <span>上一篇</span>
              <strong>{previousEntry.title}</strong>
              <small>{previousEntry.category}</small>
            </a>
          ) : (
            <div class="nav-card placeholder">
              <span>上一篇</span>
              <strong>没有更早的同类内容</strong>
            </div>
          )}

          {nextEntry ? (
            <a class="nav-card" href={nextEntry.url}>
              <span>下一篇</span>
              <strong>{nextEntry.title}</strong>
              <small>{nextEntry.category}</small>
            </a>
          ) : (
            <div class="nav-card placeholder">
              <span>下一篇</span>
              <strong>没有更新的同类内容</strong>
            </div>
          )}
        </div>
      </section>
    )}

    {relatedEntries.length > 0 && (
      <section class="section-block">
        <div class="related-header">
          <p class="eyebrow">Keep Reading</p>
          <h2>相关文章</h2>
        </div>
        <div class="grid">
          {relatedEntries.map((relatedEntry) => <ContentCard entry={relatedEntry} />)}
        </div>
      </section>
    )}
  </article>
</Layout>

<style>
  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 4vw, 4rem);
    line-height: 0.96;
    position: relative;
    z-index: 1;
  }

  .note-hero {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.72), rgba(255, 255, 255, 0.46)),
      linear-gradient(140deg, rgba(236, 247, 250, 0.88), rgba(229, 241, 247, 0.64));
  }

  .entry-shell {
    display: grid;
    gap: 1.75rem;
  }

  .entry-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 1.5rem;
    align-items: start;
  }

  .entry-prose {
    min-width: 0;
    padding: clamp(1.35rem, 2vw, 2rem);
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.44);
    background: rgba(255, 255, 255, 0.42);
    backdrop-filter: var(--blur-lg);
    -webkit-backdrop-filter: var(--blur-lg);
    box-shadow: var(--shadow-panel);
    line-height: 1.85;
  }

  .entry-actions {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .entry-actions a {
    text-decoration: none;
    font-weight: 700;
  }

  .entry-aside {
    position: sticky;
    top: 6.2rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    align-self: start;
    max-height: calc(100vh - 7.2rem);
    padding: 0.1rem;
  }

  .aside-section {
    padding: 1.05rem;
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.44);
    background: rgba(255, 255, 255, 0.34);
    backdrop-filter: var(--blur-md);
    -webkit-backdrop-filter: var(--blur-md);
    box-shadow: var(--shadow-soft);
  }

  .toc-section {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
  }

  .aside-section h2,
  .related-header h2 {
    margin: 0;
    font-size: 1rem;
    letter-spacing: 0.02em;
  }

  .aside-empty {
    margin: 0.75rem 0 0;
    color: var(--muted);
  }

  .toc-nav {
    margin-top: 0.85rem;
    min-height: 0;
    overflow-y: auto;
    padding-right: 0.25rem;
    flex: 1 1 auto;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }

  .toc-list li a {
    display: inline-flex;
    color: inherit;
    text-decoration: none;
  }

  .toc-list li a:hover {
    color: var(--accent-strong);
  }

  .toc-list li.nested {
    padding-left: 0.9rem;
    color: var(--muted);
  }

  .tag-cloud {
    gap: 0.6rem;
  }

  .tag-cloud li {
    padding: 0;
    border: 0;
    background: transparent;
  }

  .tag-cloud li a {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.38rem 0.72rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.38);
    background: rgba(255, 255, 255, 0.4);
    color: var(--muted-strong);
    text-decoration: none;
    line-height: 1.2;
    transition: var(--transition);
  }

  .tag-cloud li a:hover {
    transform: translateY(-1px);
    border-color: rgba(109, 126, 171, 0.32);
    background: rgba(109, 126, 171, 0.14);
    color: var(--accent-strong);
  }

  .navigation-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem;
  }

  .nav-card {
    display: grid;
    gap: 0.45rem;
    padding: 1.15rem 1.2rem;
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.44);
    background: rgba(255, 255, 255, 0.38);
    backdrop-filter: var(--blur-md);
    -webkit-backdrop-filter: var(--blur-md);
    box-shadow: var(--shadow-soft);
    color: inherit;
    text-decoration: none;
    transition:
      var(--transition);
  }

  .nav-card:hover {
    transform: translateY(-2px);
    border-color: var(--line-strong);
    box-shadow: var(--shadow-panel);
  }

  .nav-card span {
    color: var(--muted);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .nav-card strong {
    font-size: 1.08rem;
  }

  .nav-card small {
    color: var(--muted);
  }

  .nav-card.placeholder {
    color: var(--muted);
  }

  .related-header {
    margin-bottom: 1rem;
  }

  .related-header .eyebrow {
    margin: 0 0 0.45rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.72rem;
    font-weight: 700;
  }

  :global(.entry-prose h2),
  :global(.entry-prose h3) {
    scroll-margin-top: 7rem;
  }

  :global(.entry-prose > :first-child) {
    margin-top: 0;
  }

  :global(.entry-prose > :last-child) {
    margin-bottom: 0;
  }

  :global(.entry-prose p),
  :global(.entry-prose ul),
  :global(.entry-prose ol),
  :global(.entry-prose blockquote),
  :global(.entry-prose pre),
  :global(.entry-prose table) {
    margin: 1.05rem 0;
  }

  :global(.entry-prose ul),
  :global(.entry-prose ol) {
    padding-left: 1.5rem;
  }

  :global(.entry-prose li + li) {
    margin-top: 0.35rem;
  }

  :global(.entry-prose h2) {
    margin-top: 2.2rem;
    margin-bottom: 0.8rem;
    font-size: clamp(1.55rem, 2.4vw, 2rem);
    line-height: 1.12;
  }

  :global(.entry-prose h3) {
    margin-top: 1.65rem;
    margin-bottom: 0.65rem;
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    line-height: 1.18;
  }

  :global(.entry-prose h2 a),
  :global(.entry-prose h3 a) {
    color: inherit;
    text-decoration: none;
  }

  :global(.entry-prose h2 a:hover),
  :global(.entry-prose h3 a:hover) {
    color: var(--accent-strong);
  }

  :global(.entry-prose a) {
    color: var(--accent);
    text-underline-offset: 0.15em;
  }

  :global(.entry-prose blockquote) {
    padding: 1rem 1.1rem;
    border-left: 4px solid rgba(62, 95, 115, 0.45);
    background: rgba(62, 95, 115, 0.07);
    color: var(--muted-strong);
    border-radius: var(--radius-sm);
  }

  :global(.entry-prose code) {
    padding: 0.14rem 0.38rem;
    border-radius: 0.4rem;
    background: rgba(62, 95, 115, 0.09);
    font-size: 0.92em;
  }

  :global(.entry-prose pre) {
    padding: 1.05rem 1.1rem;
    border-radius: var(--radius-md);
    background: #1f303b;
    color: #eef5f8;
    overflow-x: auto;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  :global(.entry-prose pre code) {
    padding: 0;
    background: transparent;
    color: inherit;
  }

  :global(.entry-prose table) {
    width: 100%;
    border-collapse: collapse;
    overflow: hidden;
    border-radius: var(--radius-md);
    border: 1px solid var(--line);
  }

  :global(.entry-prose th),
  :global(.entry-prose td) {
    padding: 0.75rem 0.9rem;
    text-align: left;
    border-bottom: 1px solid var(--line);
  }

  :global(.entry-prose th) {
    background: rgba(62, 95, 115, 0.08);
  }

  :global(.entry-prose hr) {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 1.6rem 0;
  }

  :global(.entry-prose img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
  }

  @media (max-width: 1040px) {
    .entry-layout {
      grid-template-columns: minmax(0, 1fr) 260px;
    }
  }

  @media (max-width: 860px) {
    .entry-layout,
    .navigation-grid {
      grid-template-columns: 1fr;
    }

    .entry-aside {
      position: static;
    }
  }
</style>
