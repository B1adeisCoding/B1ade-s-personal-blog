---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

import ContentCard from "./ContentCard.astro";
import Layout from "../layouts/Layout.astro";
import type { NormalizedEntry } from "../lib/content-model";
import { formatDate } from "../lib/utils";

type HeadingLink = {
  depth: number;
  slug: string;
  text: string;
};

interface Props {
  entry: {
    data: {
      title: string;
      summary: string;
      category: string;
      tags: string[];
      date: Date;
      updated: Date;
      hidden: boolean;
      type: "article" | "note";
    };
  };
  Content: AstroComponentFactory;
  headings: HeadingLink[];
  previousEntry?: NormalizedEntry;
  nextEntry?: NormalizedEntry;
  relatedEntries: NormalizedEntry[];
}

const { entry, Content, headings, previousEntry, nextEntry, relatedEntries } = Astro.props;
const isNote = entry.data.type === "note";
const typeLabel = isNote ? "Note" : "Article";
const asideHeading = headings.length > 0 ? "目录与标签" : "快速信息";
---

<Layout title={entry.data.title} description={entry.data.summary}>
  <article class="entry-shell" id="top">
    <header class:list={["hero-panel", isNote && "note-hero"]}>
      <p class="eyebrow">{typeLabel}</p>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.summary}</p>
      <ul class="meta-list">
        <li>分类：{entry.data.category}</li>
        <li>创建：{formatDate(entry.data.date)}</li>
        <li>更新：{formatDate(entry.data.updated)}</li>
        <li>隐藏：{entry.data.hidden ? "是" : "否"}</li>
      </ul>
    </header>

    <div class="entry-layout">
      <div class="entry-prose">
        <Content />

        <div class="entry-actions">
          <a href="#top">返回顶部</a>
        </div>
      </div>

      <aside class="entry-aside">
        <section class="aside-section">
          <h2>{asideHeading}</h2>
          {headings.length > 0 ? (
            <nav aria-label="文章目录">
              <ol class="toc-list">
                {headings.map((heading) => (
                  <li class:list={[heading.depth === 3 && "nested"]}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          ) : (
            <p class="aside-empty">这篇内容没有可生成目录的小节标题。</p>
          )}
        </section>

        <section class="aside-section">
          <h2>标签</h2>
          <ul class="tag-cloud">
            {entry.data.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        </section>
      </aside>
    </div>

    {(previousEntry || nextEntry) && (
      <section class="section-block">
        <div class="navigation-grid">
          {previousEntry ? (
            <a class="nav-card" href={previousEntry.url}>
              <span>上一篇</span>
              <strong>{previousEntry.title}</strong>
              <small>{previousEntry.category}</small>
            </a>
          ) : (
            <div class="nav-card placeholder">
              <span>上一篇</span>
              <strong>已经到最早一篇</strong>
            </div>
          )}

          {nextEntry ? (
            <a class="nav-card" href={nextEntry.url}>
              <span>下一篇</span>
              <strong>{nextEntry.title}</strong>
              <small>{nextEntry.category}</small>
            </a>
          ) : (
            <div class="nav-card placeholder">
              <span>下一篇</span>
              <strong>已经到最新一篇</strong>
            </div>
          )}
        </div>
      </section>
    )}

    {relatedEntries.length > 0 && (
      <section class="section-block">
        <div class="related-header">
          <p class="eyebrow">Keep Reading</p>
          <h2>相关文章</h2>
        </div>
        <div class="grid">
          {relatedEntries.map((relatedEntry) => <ContentCard entry={relatedEntry} />)}
        </div>
      </section>
    )}
  </article>
</Layout>

<style>
  .eyebrow {
    margin: 0 0 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.76rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.4rem, 4vw, 3.8rem);
  }

  .note-hero {
    background:
      linear-gradient(135deg, rgba(12, 73, 82, 0.96), rgba(28, 106, 109, 0.86)),
      linear-gradient(180deg, rgba(255, 255, 255, 0.08), transparent);
  }

  .entry-shell {
    display: grid;
    gap: 1.5rem;
  }

  .entry-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 1.25rem;
    align-items: start;
  }

  .entry-prose {
    min-width: 0;
    padding: 1.4rem;
    border-radius: 1.2rem;
    border: 1px solid var(--border);
    background: rgba(255, 250, 242, 0.78);
    line-height: 1.82;
  }

  .entry-actions {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .entry-actions a {
    text-decoration: none;
    font-weight: 700;
  }

  .entry-aside {
    position: sticky;
    top: 1rem;
    display: grid;
    gap: 1rem;
  }

  .aside-section {
    padding: 1rem;
    border-radius: 1rem;
    border: 1px solid var(--border);
    background: rgba(255, 250, 242, 0.72);
  }

  .aside-section h2,
  .related-header h2 {
    margin: 0;
  }

  .aside-empty {
    margin: 0.75rem 0 0;
    color: var(--muted);
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0.85rem 0 0;
    display: grid;
    gap: 0.55rem;
  }

  .toc-list li a {
    color: inherit;
    text-decoration: none;
  }

  .toc-list li a:hover {
    text-decoration: underline;
  }

  .toc-list li.nested {
    padding-left: 0.9rem;
    color: var(--muted);
  }

  .navigation-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .nav-card {
    display: grid;
    gap: 0.35rem;
    padding: 1rem 1.1rem;
    border-radius: 1rem;
    border: 1px solid var(--border);
    background: rgba(255, 250, 242, 0.82);
    color: inherit;
    text-decoration: none;
  }

  .nav-card span {
    color: var(--muted);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .nav-card strong {
    font-size: 1.08rem;
  }

  .nav-card small {
    color: var(--muted);
  }

  .nav-card.placeholder {
    color: var(--muted);
  }

  .related-header {
    margin-bottom: 1rem;
  }

  :global(.entry-prose h2),
  :global(.entry-prose h3) {
    scroll-margin-top: 1.2rem;
  }

  :global(.entry-prose > :first-child) {
    margin-top: 0;
  }

  :global(.entry-prose > :last-child) {
    margin-bottom: 0;
  }

  :global(.entry-prose p),
  :global(.entry-prose ul),
  :global(.entry-prose ol),
  :global(.entry-prose blockquote),
  :global(.entry-prose pre),
  :global(.entry-prose table) {
    margin: 1rem 0;
  }

  :global(.entry-prose ul),
  :global(.entry-prose ol) {
    padding-left: 1.4rem;
  }

  :global(.entry-prose li + li) {
    margin-top: 0.35rem;
  }

  :global(.entry-prose h2 a),
  :global(.entry-prose h3 a) {
    color: inherit;
    text-decoration: none;
  }

  :global(.entry-prose h2 a:hover),
  :global(.entry-prose h3 a:hover) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  :global(.entry-prose a) {
    color: var(--hero);
    text-underline-offset: 0.15em;
  }

  :global(.entry-prose blockquote) {
    padding: 0.9rem 1rem;
    border-left: 4px solid rgba(201, 92, 35, 0.45);
    background: rgba(201, 92, 35, 0.06);
    color: var(--muted-strong);
    border-radius: 0.75rem;
  }

  :global(.entry-prose code) {
    padding: 0.14rem 0.38rem;
    border-radius: 0.4rem;
    background: rgba(37, 62, 54, 0.08);
    font-size: 0.92em;
  }

  :global(.entry-prose pre) {
    padding: 1rem;
    border-radius: 0.9rem;
    background: #1f2a27;
    color: #f5efe4;
    overflow-x: auto;
  }

  :global(.entry-prose pre code) {
    padding: 0;
    background: transparent;
    color: inherit;
  }

  :global(.entry-prose table) {
    width: 100%;
    border-collapse: collapse;
    overflow: hidden;
    border-radius: 0.9rem;
    border: 1px solid var(--border);
  }

  :global(.entry-prose th),
  :global(.entry-prose td) {
    padding: 0.75rem 0.9rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }

  :global(.entry-prose th) {
    background: rgba(37, 62, 54, 0.08);
  }

  :global(.entry-prose hr) {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 1.6rem 0;
  }

  :global(.entry-prose img) {
    max-width: 100%;
    height: auto;
    border-radius: 0.85rem;
  }

  @media (max-width: 860px) {
    .entry-layout,
    .navigation-grid {
      grid-template-columns: 1fr;
    }

    .entry-aside {
      position: static;
    }
  }
</style>
