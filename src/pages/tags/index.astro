---
import Layout from "../../layouts/Layout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { getPublicTags } from "../../lib/content";

const tags = await getPublicTags();
---

<Layout title="标签">
  <section class="hero-panel">
    <p class="kicker">Cross References</p>
    <h1>标签聚合</h1>
    <p>标签负责串联跨分类主题，只展示公开内容产生的关联。</p>
  </section>

  <section class="section-block">
    <SectionHeading
      eyebrow="Cross References"
      title="标签聚合"
      body="标签用于串起跨分类主题。这里默认只展示公开内容关联出的标签。"
    />

    <ul class="tag-cloud">
      {tags.map((tag) => (
        <li>
          <a href={`/tags/${tag.slug}/`}>{tag.name} · {tag.count}</a>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .tag-cloud {
    gap: 0.9rem;
  }

  .tag-cloud li {
    background: rgba(255, 255, 255, 0.42);
    border: 1px solid rgba(255, 255, 255, 0.42);
    backdrop-filter: var(--blur-md);
    -webkit-backdrop-filter: var(--blur-md);
    box-shadow: var(--shadow-soft);
    transition: var(--transition);
  }

  .tag-cloud li:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-panel);
  }

  .tag-cloud a {
    color: inherit;
    text-decoration: none;
  }
</style>
