---
import ContentCard from "../../components/ContentCard.astro";
import Layout from "../../layouts/Layout.astro";
import { getEntriesByCategorySlug, getPublicCategories } from "../../lib/content";

export async function getStaticPaths() {
  const categories = await getPublicCategories();
  return categories.map((category) => ({
    params: { category: category.slug },
    props: { categoryName: category.name },
  }));
}

const { category } = Astro.params;
const { categoryName } = Astro.props;
const entries = await getEntriesByCategorySlug(category!);
const articles = entries.filter((entry) => entry.type === "article");
const notes = entries.filter((entry) => entry.type === "note");
---

<Layout title={categoryName} description={`${categoryName} 分类下的文章与笔记`}>
  <section class="hero-panel">
    <p class="kicker">Category / {categoryName}</p>
    <h1>{categoryName}</h1>
    <p>这个分区下的公开内容按照更新时间倒序排列，并保留文章与笔记两条阅读路径。</p>
    <ul class="meta-list">
      <li>共计：{entries.length} 篇</li>
      <li>文章：{articles.length}</li>
      <li>笔记：{notes.length}</li>
    </ul>
  </section>

  {articles.length > 0 && (
    <section class="section-block">
      <div class="section-head">
        <h2>文章</h2>
        <p>偏完整表达，适合顺着主题连续读下去。</p>
      </div>
      <div class="grid">
        {articles.map((entry) => <ContentCard entry={entry} />)}
      </div>
    </section>
  )}

  {notes.length > 0 && (
    <section class="section-block">
      <div class="section-head">
        <h2>笔记</h2>
        <p>以高频信息和工作记录为主，适合带着问题快速定位。</p>
      </div>
      <div class="grid">
        {notes.map((entry) => <ContentCard entry={entry} />)}
      </div>
    </section>
  )}
</Layout>

<style>
  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 5vw, 4rem);
    position: relative;
    z-index: 1;
  }

  .hero-panel p,
  .meta-list {
    position: relative;
    z-index: 1;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: end;
    margin-bottom: 1rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--line);
  }

  .section-head h2 {
    margin: 0;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }

  .section-head p {
    margin: 0;
    color: var(--muted);
    max-width: 34rem;
  }

  @media (max-width: 700px) {
    .section-head {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
